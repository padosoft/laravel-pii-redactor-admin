{
    "name": "padosoft/laravel-pii-redactor-admin",
    "description": "Installable Laravel admin console for padosoft/laravel-pii-redactor.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "laravel",
        "pii",
        "redaction",
        "admin",
        "gdpr"
    ],
    "homepage": "https://github.com/padosoft/laravel-pii-redactor-admin",
    "support": {
        "source": "https://github.com/padosoft/laravel-pii-redactor-admin",
        "issues": "https://github.com/padosoft/laravel-pii-redactor-admin/issues"
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "padosoft/laravel-pii-redactor": "^1.1 || ^1.2 || dev-main"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Padosoft\\PiiRedactorAdmin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Padosoft\\PiiRedactorAdmin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Padosoft\\PiiRedactorAdmin\\PiiRedactorAdminServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/padosoft/laravel-pii-redactor"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3.30"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
